# このファイルを .env にコピーして値を埋める(.env はコミットされない)
#   cp .env.example .env

# 省略可: 設定するとゲーム登録時のタイトル自動補完・カバー画像取得が有効になる
# https://rawg.io/apidocs で無料アカウント登録して取得する
RAWG_API_KEY=

# 省略可: 設定しない場合は開発用の固定キーが使われる(個人利用のローカル環境ならそれで十分)
# セッションの署名に使うランダムな文字列。生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
